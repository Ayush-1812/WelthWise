# Copy to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres) ---
# Pooled connection (port 6543, pgbouncer) used by the app at runtime
DATABASE_URL=
# Direct connection (port 5432) used by Prisma Migrate
DIRECT_URL=

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Background jobs (Inngest) ---
# Use ONE value per key - duplicate lines silently resolve to the last one
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Rate limiting (Arcjet) ---
# Fails open: a missing/invalid key disables rate limiting silently
ARCJET_KEY=

# --- AI (Google Gemini) ---
# Requires a project with billing enabled and access to gemini-3.6-flash
GEMINI_API_KEY=

# --- Email (Resend) ---
# Sending to addresses other than your own requires a verified domain
RESEND_API_KEY=

# --- Receipt storage (Supabase Storage) ---
# Optional: without these, receipt upload is disabled and the UI says so.
# Create a PRIVATE bucket named "receipts" in the Supabase dashboard.
# The service-role key is server-side only - never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
